{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rsPostman",
  "version": "0.2.0",
  "identifier": "dev.rspostman.desktop",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first API client",
    "longDescription": "rsPostman is a local-first, Postman-compatible API client: collections, environments, scripts, runner, mock servers and more.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
